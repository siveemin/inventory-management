# Pooled connection for the app (Neon PgBouncer). Add pgbouncer=true.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
# Direct connection for Prisma migrations and db push.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
NEON_BRANCH="production"
NEON_AUTH_BASE_URL="https://ep-example.neonauth.region.aws.neon.tech/neondb/auth"
NEON_AUTH_JWKS_URL="https://ep-example.neonauth.region.aws.neon.tech/neondb/auth/.well-known/jwks.json"
NEON_AUTH_COOKIE_SECRET="generate-with-openssl-rand-base64-32"
